    { "id": "navigation", "label": "Navigation", "description": "Menus, docks, breadcrumbs and movement controls." },
    { "id": "text-effect", "label": "Text effect", "description": "Animated or stylised text treatment." },
    { "id": "loader", "label": "Loader", "description": "Loading or progress indicator." },
    { "id": "background", "label": "Background", "description": "Decorative environment behind content." },
    { "id": "gradient", "label": "Gradient", "description": "Colour-field or gradient-driven visual." },
    { "id": "section", "label": "Section", "description": "Reusable page section." },
    { "id": "template", "label": "Template", "description": "Complete page or composition." },
