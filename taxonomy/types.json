    { "id": "feedback", "label": "Feedback", "description": "Status, alert or response message." },
    { "id": "motion", "label": "Motion primitive", "description": "Moving element or animation primitive." },
    { "id": "micro-interaction", "label": "Micro-interaction", "description": "Small, focused interaction effect." },
    { "id": "display", "label": "Display", "description": "Informational content." }
